# Secret used to sign auth session cookies (JWT). Required in every environment.
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# The app's own canonical URL. Optional for local dev and on Vercel (both are
# auto-detected). Recommended when self-hosting elsewhere (a VM, Docker, a plain
# Node server): without it, Auth.js trusts whatever Host header the incoming
# request carries, which is only as safe as your reverse proxy's Host handling.
# AUTH_URL="https://your-deployed-domain.example"

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017"

# Database name (created automatically on first write).
MONGODB_DB="habit_tracker"
